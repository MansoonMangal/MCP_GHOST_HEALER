MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_DEBUG=true

# Confidence Thresholds
AUTO_HEAL_THRESHOLD=85.0
MANUAL_REVIEW_THRESHOLD=60.0

# Similarity Weights (must sum to 1.0)
WEIGHT_TEXT_SIMILARITY=0.35
WEIGHT_ATTRIBUTE_SIMILARITY=0.25
WEIGHT_DOM_STRUCTURE=0.20
WEIGHT_SEMANTIC_ROLE=0.10
WEIGHT_VISIBILITY=0.10

# Logging
LOG_LEVEL=INFO
LOG_FILE=../reports/logs/mcp_server.log

# Database
DB_PATH=database
