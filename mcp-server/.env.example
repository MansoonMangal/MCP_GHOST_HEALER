MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_DEBUG=false
LOG_LEVEL=INFO

# Security (set in production on Render)
GHOST_API_KEY=
CORS_ORIGINS=*
MAX_REQUEST_BYTES=5242880

AUTO_HEAL_THRESHOLD=50.0
MANUAL_REVIEW_THRESHOLD=30.0

DB_PATH=database
# Render Postgres (auto-linked as DATABASE_URL) or MongoDB Atlas (mongodb+srv://...)
DATABASE_URL=
MONGO_URI=

LOG_FILE=../reports/logs/mcp_server.log
