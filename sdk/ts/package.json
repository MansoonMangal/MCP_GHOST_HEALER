{
  "name": "ghost-healer-ts-sdk",
  "version": "1.2.2",
  "description": "Universal AI Self-Healing SDK for Playwright and Selenium (TS/JS) — zero-change activation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ghost-playwright": "./bin/ghost-playwright.js",
    "ghost-healer": "./bin/ghost-healer.js"
  },
  "files": [
    "dist",
    "src/auto-activate.js",
    "src/pw-hook.js",
    "src/projectEnv.js",
    "src/credentials.js",
    "builtin-access.json",
    "bin",
    "scripts/postinstall.js"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./auto-activate": "./src/auto-activate.js",
    "./pw-hook.js": "./src/pw-hook.js",
    "./projectEnv": "./src/projectEnv.js",
    "./selenium-setup": "./dist/selenium-setup.js",
    "./selenium-setup.js": "./dist/selenium-setup.js",
    "./dist/setup": "./dist/setup.js",
    "./dist/setup.js": "./dist/setup.js",
    "./dist/teardown": "./dist/teardown.js",
    "./dist/teardown.js": "./dist/teardown.js"
  },
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "build": "npm run clean && tsc && node scripts/copy-dist-assets.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "playwright",
    "selenium",
    "self-healing",
    "mcp",
    "automation"
  ],
  "author": "Mansoon Mangal",
  "license": "MIT",
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "selenium-webdriver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@types/node": "^20.0.0",
    "@types/selenium-webdriver": "^4.35.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
